# ============================================================
# Rupesh Portfolio — Environment Configuration
# Copy this file to .env before starting the development server
# ============================================================

# Django Secret Key (generate a secure random string for production)
SECRET_KEY=django-insecure-rupesh-portfolio-dev-secret-key-replace-in-production

# Debug Mode: True for development, False for production
DEBUG=True

# Allowed Hosts (comma-separated list of host/domain names)
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Connection URL (Optional)
# Defaults to SQLite (db.sqlite3) if left empty or commented out.
# For PostgreSQL in production, uncomment and edit the line below:
# DATABASE_URL=postgres://rupesh_user:password@localhost:5432/rupesh_portfolio_db
